[Unit]
Description=MotoAMG LiveKit token server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/livekit/token-server
EnvironmentFile=/home/ubuntu/livekit/token-server/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
