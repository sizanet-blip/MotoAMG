rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          groupDoc(groupId).ownerId == request.auth.uid
          || (
            'adminUids' in groupDoc(groupId)
            && groupDoc(groupId).adminUids is list
            && request.auth.uid in groupDoc(groupId).adminUids
          )
        );
    }

    /// Admin (o creador) puede dejar a un motero sin grupo (solo ese campo).
    function adminCanClearMemberGroup() {
      let groupId = resource.data.currentGroupId;
      return isSignedIn()
        && groupId is string
        && request.resource.data.currentGroupId == null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentGroupId'])
        && isGroupAdmin(groupId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isSelf(userId);
      allow update: if isSelf(userId) || adminCanClearMemberGroup();

      match /memberships/{groupId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId)
          || !exists(/databases/$(database)/documents/users/$(userId))
          || isGroupAdmin(groupId);
      }

      match /clubMemberships/{clubId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId);
      }
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    /// Lookup público para entrar con usuario (sin correo).
    /// El documento no guarda la contraseña en claro; sí un secreto cifrado
    /// con ella, necesario para iniciar sesión antes de autenticarse.
    function ownsUsernameEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email == resource.data.authEmail;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authEmail is string
        && request.resource.data.salt is string
        && request.resource.data.wrappedSecret is string;
      /// El dueño actual, o quien recreó la cuenta Auth con el mismo correo
      /// sintético (p. ej. borró el usuario en Authentication y vuelve a
      /// registrarse).
      allow update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authEmail == resource.data.authEmail
        && request.resource.data.salt is string
        && request.resource.data.wrappedSecret is string
        && (
          resource.data.uid == request.auth.uid
          || ownsUsernameEmail()
        );
      allow delete: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || ownsUsernameEmail()
        );
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && !isAnonymous()
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if isSignedIn();
      /// Solo el creador gestiona el documento del grupo (p. ej. adminUids).
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      match /members/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        /// El propio miembro o un admin (roles de marcha, etc.).
        allow update: if isSignedIn() && (
          request.auth.uid == userId
          || isGroupAdmin(groupId)
        );
        allow delete: if isSignedIn() && (
          request.auth.uid == userId
          || isGroupAdmin(groupId)
          || !exists(/databases/$(database)/documents/users/$(userId))
        );
      }

      /// Ruta compartida del grupo (p. ej. sharedRoute/current).
      match /sharedRoute/{docId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isGroupAdmin(groupId);
      }
    }

    // --- Clubs / peñas (alta vía panel AMG; app une y solicita) ---
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // solo Admin SDK (Yii2)

      match /members/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && (
          request.auth.uid == userId
          || (
            exists(/databases/$(database)/documents/clubs/$(clubId))
            && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.adminUids
          )
        );
      }
    }

    match /club_invites/{code} {
      allow read: if isSignedIn();
      allow create, delete: if false;
      allow update: if isSignedIn(); // usedCount al unirse
    }

    match /club_requests/{requestId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false; // aprobación solo panel (Admin SDK)
    }
  }
}
