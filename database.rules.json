{
  "rules": {
    "live_locations": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || !newData.exists())"
        }
      }
    },
    "group_alerts": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.hasChildren())"
        }
      }
    },
    "group_stops": {
      "$groupId": {
        ".read": "auth != null",
        "$stopId": {
          ".write": "auth != null"
        }
      }
    }
  }
}
