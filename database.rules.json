{
  "rules": {
    "live_locations": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || !newData.exists())"
        }
      }
    },
    "group_alerts": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.hasChildren())"
        }
      }
    },
    "group_stops": {
      "$groupId": {
        ".read": "auth != null",
        "$stopId": {
          ".write": "auth != null"
        }
      }
    },
    "group_voice": {
      "$groupId": {
        ".read": "auth != null",
        "$announcementId": {
          ".write": "auth != null && (!newData.exists() || (newData.hasChildren() && newData.child('uid').val() === auth.uid))"
        }
      }
    }
  }
}
